FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir "ansible-core==2.18.6"

WORKDIR /opt/opspilot/backend
COPY backend/pyproject.toml ./
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./
COPY ansible /opt/opspilot/ansible
COPY test-assets /opt/opspilot/test-assets

RUN /opt/venv/bin/pip install --no-cache-dir . \
    && groupadd --gid 10001 opspilot \
    && useradd --uid 10001 --gid opspilot --create-home opspilot \
    && mkdir -p /opt/opspilot/runtime \
    && chmod 0755 /opt/opspilot/test-assets/services.sh \
    && chown -R opspilot:opspilot /opt/opspilot

USER 10001

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
