# OpsPilot local-demo reference configuration. The Make targets provide these
# synthetic defaults directly, so copying this file is optional.
OPSPILOT_LLM_MODE=deterministic
OPSPILOT_EXECUTOR=ansible
OPSPILOT_WORKFLOW_CHECKPOINT_BACKEND=postgres
OPSPILOT_MEMORY_BACKEND=disabled
OPSPILOT_MCP_ENABLED=false

# demo-full enables local Qdrant and MCP through its Compose profile. OpenAI
# remains opt-in and must never be required by the canonical demo.
# OPSPILOT_LLM_MODE=llm
# OPENAI_API_KEY=replace-only-for-an-opt-in-manual-demo
