# Generic template. Copy to config/application.yml and replace placeholders manually.
# Site-specific paths, IP addresses, usernames and secrets must not be committed here.
environment:
  name: local
  mode: mock
  description: Deployment-neutral development profile

executor:
  # First-phase choices: mock or local_services.
  # ansible_playbook is a fail-closed NOT_IMPLEMENTED extension point.
  type: mock
  timeout: 30
  retry: 0
  concurrency: 4
  partial_failure_policy: NONE

services:
  script_path:
  working_directory:
  command_profile: "pending-confirmation"
  output_parser: "raw_output"

ssh:
  # Reserved legacy configuration only; it is not an enabled execution path.
  enabled: false
  host:
  port: 22
  username:
  private_key: ${OPSPILOT_SSH_PRIVATE_KEY_PATH}
  timeout: 10
  known_hosts_path:
  # Reserved for a confirmed jump-host/bastion connection design.
  jump_mode:
  jump_host:

remote:
  working_directory:

security:
  write_enabled: false
  production_enabled: false
  dry_run_only: true
  execution_acknowledged: false
  approval_required_for_write: true

allowlist:
  environments: []
  hosts: []
  services: []
  actions:
    - status
