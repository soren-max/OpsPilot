# Copy to .env for local development. Values below are non-secret placeholders only.
OPSPILOT_ENVIRONMENT=development
OPSPILOT_DATABASE_URL=sqlite:///./opspilot_ops.db
OPSPILOT_EXECUTOR=mock
OPSPILOT_WRITE_OPERATIONS_ENABLED=false
OPSPILOT_PRODUCTION_OPERATIONS_ENABLED=false
OPSPILOT_DRY_RUN_ONLY=true
OPSPILOT_EXECUTION_ACKNOWLEDGED=false
OPSPILOT_EXECUTION_DISPATCH_LEASE_SECONDS=60
# Optional governed Harness profile. Setting a pipeline identifier requires all fields below.
OPSPILOT_HARNESS_BASE_URL=
OPSPILOT_HARNESS_ACCOUNT_ID=
OPSPILOT_HARNESS_ORG_ID=
OPSPILOT_HARNESS_PROJECT_ID=
OPSPILOT_HARNESS_API_KEY=
OPSPILOT_HARNESS_RESTART_PIPELINE_IDENTIFIER=
OPSPILOT_WORKER_POLL_SECONDS=1
OPSPILOT_WORKFLOW_CHECKPOINT_BACKEND=auto
# Durable deployments: set this to postgres and use a PostgreSQL database URL.
OPSPILOT_PROMETHEUS_BASE_URL=
OPSPILOT_PROMETHEUS_AUTH_TOKEN=
OPSPILOT_LOKI_BASE_URL=
OPSPILOT_LOKI_AUTH_TOKEN=
OPSPILOT_LOKI_TENANT=
OPSPILOT_CAPABILITY_TIMEOUT_SECONDS=5
OPSPILOT_CAPABILITY_MAX_TIME_RANGE_SECONDS=3600
OPSPILOT_CAPABILITY_MAX_LOG_ENTRIES=100
OPSPILOT_CAPABILITY_MAX_METRIC_SERIES=20
OPSPILOT_CAPABILITY_MINIMUM_STEP_SECONDS=15

# AI investigation defaults to the fully offline deterministic baseline.
LLM_MODE=deterministic
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MUTATING_ACTION_MIN_CONFIDENCE=0.8
OPSPILOT_CORS_ORIGINS=
OPSPILOT_LOG_LEVEL=INFO
OPSPILOT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# Local development / Mock / Dry Run only. Do not reuse these values in production.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD
DEFAULT_ADMIN_ENABLED=true

# Infrastructure adapter paths and target allowlists are deployment-owned configuration.
# They are intentionally absent from this public development template.
OPSPILOT_RBAC_ENABLED=true
OPSPILOT_APPROVAL_REQUIRED_FOR_WRITE=true

# Optional MySQL overlay. Keep these unset for the default SQLite deployment.
# Inject completed values from the target host .env or its secret manager.
# MYSQL_DATABASE=opspilot_ops
# MYSQL_USER=opspilot_ops
# MYSQL_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD
# MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATE_A_DIFFERENT_STRONG_PASSWORD
# OPSPILOT_MYSQL_DATABASE_URL=mysql+pymysql://opspilot_ops:URL_ENCODED_PASSWORD@mysql:3306/opspilot_ops?charset=utf8mb4

# Docker image defaults. Do not put real secrets or infrastructure assets here.
OPSPILOT_IMAGE_TAG=v0.1.0
OPSPILOT_DATABASE_DIR=./runtime-data/database
OPSPILOT_API_LOG_DIR=./runtime-data/logs/api
OPSPILOT_WORKER_LOG_DIR=./runtime-data/logs/worker
OPSPILOT_API_BIND=
OPSPILOT_API_PORT=8000
OPSPILOT_WEB_PORT=8080
OPSPILOT_DEV_WEB_PORT=5173

# Optional frontend override. Vite proxy is used when omitted.
# VITE_API_BASE_URL=
